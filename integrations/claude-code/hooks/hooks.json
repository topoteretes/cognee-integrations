{
  "description": "Cognee memory hooks, each handed to the plugin's MCP server.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:cognee-memory:cognee",
            "tool": "cognee_hook",
            "input": {
              "hook_event_name": "${hook_event_name}",
              "session_id": "${session_id}",
              "transcript_path": "${transcript_path}",
              "cwd": "${cwd}",
              "prompt": "${prompt}"
            }
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:cognee-memory:cognee",
            "tool": "cognee_hook",
            "input": {
              "hook_event_name": "${hook_event_name}",
              "session_id": "${session_id}",
              "transcript_path": "${transcript_path}",
              "cwd": "${cwd}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}"
            }
          }
        ],
        "matcher": "Read"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:cognee-memory:cognee",
            "tool": "cognee_hook",
            "input": {
              "hook_event_name": "${hook_event_name}",
              "session_id": "${session_id}",
              "transcript_path": "${transcript_path}",
              "cwd": "${cwd}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}",
              "tool_response": "${tool_response}"
            }
          }
        ],
        "matcher": "Bash|Agent|Read|Write|Edit|Grep|Glob"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:cognee-memory:cognee",
            "tool": "cognee_hook",
            "input": {
              "hook_event_name": "${hook_event_name}",
              "session_id": "${session_id}",
              "transcript_path": "${transcript_path}",
              "cwd": "${cwd}"
            }
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:cognee-memory:cognee",
            "tool": "cognee_hook",
            "input": {
              "hook_event_name": "${hook_event_name}",
              "session_id": "${session_id}",
              "transcript_path": "${transcript_path}",
              "cwd": "${cwd}"
            }
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:cognee-memory:cognee",
            "tool": "cognee_hook",
            "input": {
              "hook_event_name": "${hook_event_name}",
              "session_id": "${session_id}",
              "transcript_path": "${transcript_path}",
              "cwd": "${cwd}"
            }
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:cognee-memory:cognee",
            "tool": "cognee_hook",
            "input": {
              "hook_event_name": "${hook_event_name}",
              "session_id": "${session_id}",
              "transcript_path": "${transcript_path}",
              "cwd": "${cwd}"
            }
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:cognee-memory:cognee",
            "tool": "cognee_hook",
            "input": {
              "hook_event_name": "${hook_event_name}",
              "session_id": "${session_id}",
              "transcript_path": "${transcript_path}",
              "cwd": "${cwd}"
            }
          }
        ]
      }
    ]
  }
}
