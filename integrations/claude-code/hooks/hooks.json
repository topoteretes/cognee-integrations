{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:cognee-memory:cognee",
            "tool": "recall",
            "input": {
              "query": "${prompt}",
              "session_id": "${session_id}"
            },
            "statusMessage": "Recalling from Cognee..."
          },
          {
            "type": "mcp_tool",
            "server": "plugin:cognee-memory:cognee",
            "tool": "remember",
            "input": {
              "data": "${prompt}",
              "session_id": "${session_id}"
            }
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:cognee-memory:cognee",
            "tool": "remember",
            "input": {
              "data": "${tool_name}: ${tool_input}",
              "session_id": "${session_id}"
            }
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:cognee-memory:cognee",
            "tool": "remember",
            "input": {
              "data": "${last_assistant_message}",
              "session_id": "${session_id}"
            }
          }
        ]
      }
    ]
  }
}
