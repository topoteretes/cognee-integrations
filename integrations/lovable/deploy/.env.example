# ── Cognee backend (server-held; never reaches Lovable) ─────────────────────
# Cognee Cloud: the tenant API base URL and an API key from Cognee Cloud → API Keys.
# Self-hosted: the server's URL and an API key minted on it (see README).
COGNEE_BASE_URL=https://your-tenant.aws.cognee.ai
COGNEE_API_KEY=

# ── Connector scope ──────────────────────────────────────────────────────────
# The one dataset this deployment writes to (created on first write).
LOVABLE_PROJECT_DATASET=lovable_my_product
# Optional comma-separated read-only datasets (must already exist; never created).
LOVABLE_SHARED_DATASETS=

# ── Inbound authentication (what Lovable presents) ──────────────────────────
# Generate with: npx @cognee/lovable-memory token
# Comma-separate two values during a rotation; remove the old one afterwards.
LOVABLE_MCP_TOKEN=

# ── Public endpoint ──────────────────────────────────────────────────────────
# The https:// URL Lovable will call (your reverse proxy). Its hostname is
# added to the Host allowlist and its origin to the Origin allowlist.
LOVABLE_PUBLIC_URL=https://memory.example.com

# ── Optional tuning ──────────────────────────────────────────────────────────
# LOVABLE_RECALL_TOP_K=5
# LOVABLE_MAX_RECALL_RESULTS=10
# LOVABLE_MAX_RECALL_CHARS=6000
# LOVABLE_MAX_CONTENT_CHARS=4000
# LOVABLE_RECALL_MODE=evidence            # or answer
# LOVABLE_RECALL_ALLOW_ANSWER_MODE=true
# LOVABLE_LOG_LEVEL=info
