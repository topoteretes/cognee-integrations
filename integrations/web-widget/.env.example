# A running cognee server (holds the LLM_API_KEY and builds/queries memory).
COGNEE_BASE_URL=http://localhost:8000
# Omit for a local cognee with access control disabled.
COGNEE_API_KEY=

# Where the widget backend itself listens.
WEB_HOST=127.0.0.1
WEB_PORT=8000

# Demo "ask our docs" site id, and CORS allow-list (comma-separated; "*" = any).
WIDGET_SITE_ID=demo
WIDGET_ALLOWED_ORIGINS=*

# Request limits on the public /api/chat and /api/forget (0 turns one off).
# Per visitor IP, counting chat and forget together:
WIDGET_RATE_LIMIT_PER_IP_HOUR=20
WIDGET_RATE_LIMIT_PER_IP_DAY=100
# Chat requests per hour across all visitors, the ceiling on tenant spend:
WIDGET_RATE_LIMIT_GLOBAL_HOUR=500
# Behind a reverse proxy: the proxy IPs or CIDR ranges whose X-Forwarded-For is
# believed ("*" = whichever peer connects). Unset, every request counts against
# the address that connected, so behind a proxy all visitors share one limit.
WIDGET_TRUSTED_PROXIES=

# Contact form: where the assistant's hand-offs to the team are emailed. The form
# is off until both WIDGET_CONTACT_TO and WIDGET_SMTP_HOST are set.
WIDGET_CONTACT_TO=
WIDGET_SMTP_HOST=
WIDGET_SMTP_PORT=587
WIDGET_SMTP_USER=
WIDGET_SMTP_PASSWORD=
WIDGET_SMTP_FROM=
# starttls (default), ssl or none
WIDGET_SMTP_SECURITY=starttls

# Where the ingested repository can be browsed; related code links to file and line.
WIDGET_CODE_BASE_URL=

# GitHub sync: a push webhook to /api/github/webhook keeps the docs corpus current.
# Off until the secret is set; it must match the one in the webhook's settings.
WIDGET_GITHUB_WEBHOOK_SECRET=
# Needed to read a private repository (contents: read).
WIDGET_GITHUB_TOKEN=
# Folder in the repository the corpus mirrors (empty = repository root).
WIDGET_GITHUB_DOCS_DIR=
# Empty = the repository's default branch.
WIDGET_GITHUB_BRANCH=
# owner/name; empty accepts any repository that holds the secret.
WIDGET_GITHUB_REPO=
WIDGET_GITHUB_EXTENSIONS=.md,.mdx
