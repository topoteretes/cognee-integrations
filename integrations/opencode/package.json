{
  "name": "@cognee/cognee-opencode",
  "version": "2026.9.5",
  "type": "module",
  "description": "OpenCode Cognee-backed memory plugin with auto-recall and custom tools",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  },
  "bin": {
    "cognee-opencode": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "drop-in"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@opencode-ai/plugin": ">=1.18.28 <=1.18.29"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/src/client.d.ts",
      "import": "./dist/src/client.js"
    }
  }
}
