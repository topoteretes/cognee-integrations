# Tapes core API the cassette syncs sessions from.
TAPES_BASE_URL=http://127.0.0.1:8081

# Cognee dataset holding the session memory.
COGNEE_TAPES_DATASET=tapes_sessions

# Where the cassette itself listens (tapes proxies to this).
CASSETTE_HOST=127.0.0.1
CASSETTE_PORT=9900

# LLM key used by cognee (in-process) for cognify/search.
OPENAI_API_KEY=

# Optional: force cognee's data/system storage under this directory so the
# cassette never writes into a globally-configured cognee store.
COGNEE_STORAGE_ROOT=

# Optional: sync checkpoint/hash state file (default: .cognee-cassette-state-<dataset>.json).
CASSETTE_STATE_PATH=
