# Copy to .env and fill in. The .env is gitignored; never commit real secrets.
#
# Note: the app's onboarding (menu bar → Setup…) writes
# ~/.cognee-spotlight/backend.env, which run_backend.sh sources AFTER this
# file — a choice made in the app wins over this developer config.

# How the backend reaches cognee:
#   fake  - no keys, no network; substring search. For trying the app end to end.
#   local - cognee runs in-process on this machine; needs LLM_API_KEY.
#   cloud - a cognee server or cognee cloud over HTTP.
COGNEE_MODE=fake

# --- local mode ---
# cognee extracts knowledge with an LLM at index time.
LLM_API_KEY=
# run_backend.sh isolates cognee storage under ~/.cognee-spotlight/cognee/ so it
# never shares a database with another cognee install (even if your shell
# exports *_ROOT_DIRECTORY globally). Override the isolation root if needed:
# SPOTLIGHT_COGNEE_ROOT=

# --- cloud mode ---
COGNEE_CLOUD_URL=https://api.cognee.ai
COGNEE_CLOUD_API_KEY=

# --- team handover (share learnings with teammates) ---
# Who you are and where the shared central cognee server lives. When both are
# set, the backend gains /share and /inbox, and the app gets the Share/Inbox UI
# plus notifications. COGNEE_BASE_URL/COGNEE_API_KEY (the Claude Code plugin's
# vars) are honored as fallbacks, so one central server serves both.
SPOTLIGHT_USER=
SPOTLIGHT_TEAM=
COGNEE_HUB_URL=
COGNEE_HUB_API_KEY=

# --- backend server (the macOS app talks to this) ---
SPOTLIGHT_HOST=127.0.0.1
SPOTLIGHT_PORT=8765
# SPOTLIGHT_DATASET=spotlight
# SPOTLIGHT_DATA_DIR=~/.cognee-spotlight
# Comma-separated extension override, e.g. md,txt,pdf
# SPOTLIGHT_EXTENSIONS=
